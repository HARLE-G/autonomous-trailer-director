  "usable_descriptions": {
    "s01": {
      "human_description": "Asha and Ravi arrive at their grandfather Dada's lighthouse house. Warm, hopeful.",
      "ai_description": "Two children with bags walk up to an old lighthouse cottage; an elderly man welcomes them."
    },
    "s02": {
      "human_description": "Ravi pokes at a loose brick and finds a sealed letter addressed to both siblings.",
      "ai_description": "A boy pulls a brick out of a wall and holds up an envelope, delighted."
    },
    "s03": {
      "human_description": "Dada refuses to discuss the letter. Asha pushes back. Gentle tension.",
      "ai_description": "An old man turns away from a letter; a girl folds her arms."
    },
    "s04": {
      "human_description": "Ravi plays detective with a cardboard kit; neighbour Meera brings food.",
      "ai_description": "A boy in a paper hat trips over a rug; a woman sets down a tray."
    },
    "s05": {
      "human_description": "Village harvest evening; Dada sings a folk song with neighbours. Asha notes he hums it when remembering.",
      "ai_description": "People gather around a fire at dusk; an old man sings and children clap."
    },
    "s06": {
      "human_description": "A strange light sweeps the house at night; footsteps upstairs. Sustained fear for a young child.",
      "ai_description": "A dark house, a swinging beam, a boy hiding under a blanket, heavy footsteps."
    },
    "s07": {
      "human_description": "The siblings argue: Asha wants to burn the letter, Ravi wants to read it.",
      "ai_description": "Two siblings shout at each other over an envelope near a stove."
    },
    "s08": {
      "human_description": "The siblings flee across boat-shed roofs; a man in a raincoat grabs Ravi's sleeve. Mild peril.",
      "ai_description": "Children run over slanted roofs in rain; a man reaches for a boy."
    },
    "s09": {
      "human_description": "Inspector Kaul demands the letter from Dada and threatens the house. Dada stands his ground.",
      "ai_description": "Physical intimidation, violence is mild."
    },
    "s10": {
      "human_description": "Reconciled, the siblings decode the map together; banter returns. The map ends at the lamp room.",
      "ai_description": "The siblings study a hand-drawn map by torchlight. They laugh and point at the lamp room."
    },
    "s11": {
      "human_description": "Harbour friend Neel supports Asha on the pier; later a kiss.",
      "ai_description": "A young couple on a pier at dusk; they kiss."
    },
    "s12": {
      "human_description": "Meera pours tea. Later, alone, she opens a tin box of letters in the children's mother's handwriting, hidden for years.",
      "ai_description": "A woman smiles; later she lifts a tin box full of envelopes."
    },
    "s13": {
      "human_description": "A radio crackles: their mother's voice, alive after all these years.",
      "ai_description": "A radio glows in a dark room; Asha's face as a voice speaks."
    }
  },
